    {
      "name": "2. Employee - task CRUD and workflow",
      "description": "List (paginated), create, validate, show, update, start and complete a task as the employee.",
      "item": [
        {
          "name": "List my tasks (paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_employee}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks?per_page=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "5"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Paginated JSON: data, links, meta', () => { pm.expect(j).to.have.property('data'); pm.expect(j).to.have.property('links'); pm.expect(j.meta).to.have.property('total'); });",
                  "pm.test('per_page is honoured', () => pm.expect(j.meta.per_page).to.eql(5));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_employee}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman: prepare the monthly report\",\n  \"description\": \"Created from Postman.\",\n  \"priority\": \"high\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('New task starts as PENDING', () => pm.expect(j.data.status.value).to.eql('PENDING'));",
                  "pm.collectionVariables.set('task_id', j.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create with invalid data -> 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_employee}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"ab\",\n  \"priority\": \"urgent\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
