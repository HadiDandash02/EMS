{
  "info": {
    "name": "TaskFlow API",
    "description": "REST API of TaskFlow (Employee Task & Approval Management). Import this collection AND the environment file, fill the 3 passwords in the environment, then run the collection (Runner) or send the requests one by one from top to bottom.\n\nEvery request has tests (the green PASS marks in Postman).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "token_employee",
      "value": ""
    },
    {
      "key": "token_manager",
      "value": ""
    },
    {
      "key": "token_hr",
      "value": ""
    },
    {
      "key": "task_id",
      "value": ""
    },
    {
      "key": "other_task_id",
      "value": ""
    },
    {
      "key": "reject_task_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Authentication (Sanctum bearer tokens)",
      "description": "Log in once per role. Each token is saved automatically in a collection variable and used by the next requests.",
      "item": [
        {
          "name": "Login - employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{employee_username}}\",\n  \"password\": \"{{employee_password}}\",\n  \"device_name\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('A bearer token is returned', () => pm.expect(j.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token_employee', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - manager",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
