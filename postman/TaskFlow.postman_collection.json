            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{manager_username}}\",\n  \"password\": \"{{manager_password}}\",\n  \"device_name\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/login",
