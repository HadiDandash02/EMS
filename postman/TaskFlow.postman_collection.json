          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('IN_PROGRESS', () => pm.expect(pm.response.json().data.status.value).to.eql('IN_PROGRESS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete the task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
