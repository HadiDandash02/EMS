        {
          "name": "Start the task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_employee}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{task_id}}/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "{{task_id}}",
                "start"
              ]
            },
            "description": ""
